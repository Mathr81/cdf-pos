# ─────────────────────────────────────────────────────────────
#  cdf-pos — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- Exposition (Nginx Proxy Manager gère le domaine + TLS en amont) ---
# Port hôte sur lequel le conteneur web (nginx) est publié ; NPM proxifie vers lui.
WEB_PORT=8080
# URL publique finale servie par NPM (utilisée pour CORS / Socket.IO).
PUBLIC_ORIGIN=https://pos.example.com

# --- Base de données PostgreSQL ---
POSTGRES_USER=cdf
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cdfpos
# URL utilisée par le serveur (en dev local : localhost:5432)
DATABASE_URL=postgresql://cdf:change-me-strong-password@localhost:5432/cdfpos?schema=public

# --- Serveur ---
PORT=3001
# Origines autorisées (CORS / Socket.IO). En prod : https://pos.example.com
CORS_ORIGIN=http://localhost:5173
# Charge la carte définie dans apps/server/prisma/menu.ts au 1er démarrage.
# Sans effet si des produits existent déjà en base.
SEED_ON_START=false

# --- Sécurité applicative ---
# Code d'accès partagé demandé au lancement de l'app (anti-intrus sur le NDD)
APP_ACCESS_CODE=fete2026
# PIN admin pour l'écran d'administration / stats
ADMIN_PIN=1234
# Secret de signature des jetons de session
JWT_SECRET=change-me-with-a-long-random-string

# --- Sauvegarde Google Sheet (optionnel mais recommandé) ---
# Activer le miroir Google Sheet (true/false)
BACKUP_SHEETS_ENABLED=false
# ID du Google Sheet (dans l'URL : /spreadsheets/d/<ID>/edit)
BACKUP_SHEETS_ID=
# Chemin vers le fichier JSON du compte de service Google
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# --- Sauvegardes PostgreSQL (conteneur backup-cron) ---
# Intervalle entre deux dumps (secondes) et nombre de dumps conservés.
BACKUP_INTERVAL=900
BACKUP_KEEP=96

# --- Frontend (Vite) ---
# URL de l'API/Socket vue par le navigateur. En prod, laisser vide => même origine.
VITE_API_URL=http://localhost:3001
