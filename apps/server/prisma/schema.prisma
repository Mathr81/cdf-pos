// ─────────────────────────────────────────────────────────────
//  Schéma Prisma — cdf-pos
//  Le journal `Event` est canonique. Les autres tables sont des
//  PROJECTIONS reconstruisibles à partir des événements.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Journal d'événements (source de vérité) ─────────────────
model Event {
  id               String   @id // UUID généré côté client → idempotence
  seq              Int      @unique @default(autoincrement()) // curseur de synchro monotone
  type             String
  payload          Json
  deviceId         String
  clientSeq        Int
  createdAt        DateTime // horodatage client
  serverReceivedAt DateTime @default(now())

  @@index([seq])
  @@index([type])
  @@index([deviceId, clientSeq])
}

// ─── Configuration ───────────────────────────────────────────
model Station {
  id        String    @id
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String          @id
  name           String
  priceCents     Int
  category       String          @default("Divers")
  stationId      String?
  station        Station?        @relation(fields: [stationId], references: [id])
  stockInitial   Int             @default(0)
  /// true = produit sans stock à suivre (frites au sac, sirop…) : jamais « épuisé ».
  stockUnlimited Boolean         @default(false)
  /// Composants inclus : [{ productId, qty }] — ex. « Burger Frites » → 1 « frites ».
  components     Json            @default("[]")
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  emoji          String          @default("🍔")
  color          String          @default("#f59e0b")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) // = event.createdAt, sert au last-write-wins
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  prepared       Prepared[]

  @@index([stationId])
}

// ─── Soirées (sessions de vente) ─────────────────────────────
model Soiree {
  id        String   @id
  name      String
  date      String
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// ─── Projections (issues des événements) ─────────────────────
model Order {
  id                String      @id // UUID client
  soireeId          String?
  createdAt         DateTime // horodatage client de la vente
  serverReceivedAt  DateTime    @default(now())
  deviceId          String
  registerLabel     String
  cashierName       String?
  paymentMethod     String // cash | card
  status            String      @default("paid") // paid | void
  amended           Boolean     @default(false)
  totalCents        Int
  cashReceivedCents Int?
  items             OrderItem[]

  @@index([soireeId])
  @@index([createdAt])
  @@index([status])
  @@index([registerLabel])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  qty            Int
  unitPriceCents Int

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String   @id @default(uuid())
  soireeId  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta     Int
  reason    String // restock | spoilage | correction
  note      String?
  createdAt DateTime

  @@index([productId])
  @@index([soireeId])
}

model Prepared {
  id        String   @id @default(uuid())
  soireeId  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  stationId String
  qty       Int
  createdAt DateTime

  @@index([productId])
  @@index([stationId])
  @@index([soireeId])
}

// ─── Métadonnées serveur (clé/valeur) ────────────────────────
/// Contient notamment `epoch` : identifiant de la « session de données »
/// courante. Une remise à zéro le change, ce qui signale à chaque appareil
/// qu'il doit purger son journal local au lieu de le resynchroniser.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── File de retry pour le miroir Google Sheet ───────────────
model BackupQueue {
  id        Int      @id @default(autoincrement())
  eventId   String
  eventType String
  status    String   @default("pending") // pending | done | error
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
